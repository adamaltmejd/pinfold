+/// Authority checks shared by enforcement and the static diagnostic. Parsing,
+/// DNS, SNI and delivery remain separate and are never implied by success.
+pub fn static_check<'a>(
+    allow: &[String],
+    mut routes: impl Iterator<Item = &'a str>,
+    host: &str,
+    port: Option<u16>,
+    connect: bool,
+) -> Option<&'static str> {
+    if !connect && port != Some(80) {
+        return Some("port not allowed");
+    }
+    if network::literal(host).is_some() {
+        return Some("ip literal");
+    }
+    let host = host.to_ascii_lowercase();
+    if routes.any(|name| name.eq_ignore_ascii_case(&host)) {
+        return if connect { Some("route") } else { None };
+    }
+    let allowed = allow.iter().any(|entry| {
+        let entry = entry.to_ascii_lowercase();
+        match entry.strip_prefix('.') {
+            Some(name) if !name.is_empty() => host == name || host.ends_with(&entry),
+            _ => host == entry,
+        }
+    });
+    if !allowed {
+        return Some("not allowlisted");
+    }
+    if connect && port != Some(443) {
+        return Some("port not allowed");
     }
+    None
 }
 
