+//! Disposable research contract: retained observations, never ownership.
+use std::fs::{self, File};
+use std::io::{self, BufRead, BufReader, Read};
+use std::path::PathBuf;
+
+use serde_json::{Value, json};
+
+use crate::core::{now, plan::Plan, proxy, runtime::runtime};
+use crate::dirs;
+
+const BYTES: u64 = 64 * 1024;
+
+fn path(id: &str, suffix: &str) -> io::Result<PathBuf> {
+    if id.len() != 64 || !id.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+        return Err(io::Error::other("invalid run id"));
+    }
+    Ok(dirs::state_dir()?
+        .join("runs")
+        .join(format!("{id}.{suffix}")))
+}
+
+fn save(id: &str, suffix: &str, value: Value) -> io::Result<()> {
+    let destination = path(id, suffix)?;
+    let bytes = serde_json::to_vec(&value)?;
+    if bytes.len() as u64 > BYTES {
+        return Err(io::Error::other("snapshot limit"));
+    }
+    fs::create_dir_all(destination.parent().unwrap())?;
+    let staging = destination.with_extension(format!("tmp-{}", std::process::id()));
+    fs::write(&staging, bytes)?;
+    fs::rename(staging, destination)
+}
+
+pub fn ready(id: &str, plan: &Plan, image_id: &str) {
+    let egress = plan.egress.as_ref().map(|egress| {
+        json!({
+            "allow": egress.allow,
+            "routes": egress.routes.keys().collect::<Vec<_>>(),
+        })
+    });
+    let result = save(
+        id,
+        "json",
+        json!({
+            "run_id": id, "box": plan.name, "observed_at": now(),
+            "observation": "ready", "runtime": runtime().name(),
+            "image_id": image_id, "egress": egress,
+            "resources_requested": {"cpus": plan.cpus, "memory": plan.memory},
+        }),
+    );
+    if result.is_err() {
+        eprintln!("pinfold: diagnostic snapshot unavailable");
+    }
+}
+
+pub fn terminal(id: &str, reason: &str) {
+    if save(
+        id,
+        "end.json",
+        json!({"observed_at": now(), "reason": reason}),
+    )
+    .is_err()
+    {
+        eprintln!("pinfold: terminal diagnostic unavailable");
+    }
+}
+
+fn read(id: &str, suffix: &str) -> io::Result<Value> {
+    let mut bytes = Vec::new();
+    File::open(path(id, suffix)?)?
+        .take(BYTES + 1)
+        .read_to_end(&mut bytes)?;
+    if bytes.len() as u64 > BYTES {
+        return Err(io::Error::other("snapshot limit"));
+    }
+    serde_json::from_slice(&bytes).map_err(io::Error::other)
+}
+
+pub fn query(args: &[String], check: bool) -> io::Result<i32> {
+    let Some(id) = args.first() else {
+        return Err(io::Error::other("run id required"));
+    };
+    // Validate even an absent id; no caller-controlled filesystem traversal.
+    path(id, "json")?;
+    let snapshot = match read(id, "json") {
+        Ok(snapshot) => snapshot,
+        Err(_) => {
+            println!(
+                "{}",
+                json!({"run_id": id, "availability": "unavailable", "reason": "snapshot-unavailable"})
+            );
+            return Ok(1);
+        }
+    };
+    if check {
+        if args.len() != 4 || !matches!(args[3].as_str(), "CONNECT" | "HTTP") {
+            return Err(io::Error::other("check-run RUN_ID HOST PORT CONNECT|HTTP"));
+        }
+        let port: u16 = args[2].parse().map_err(io::Error::other)?;
+        let egress = &snapshot["egress"];
+        let names = |key: &str| -> Vec<String> {
+            egress[key]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter_map(Value::as_str)
+                .map(str::to_string)
+                .collect()
+        };
+        let (allow, routes) = (names("allow"), names("routes"));
+        let reason = if egress.is_null() {
+            Some("no egress")
+        } else {
+            proxy::static_check(
+                &allow,
+                routes.iter().map(String::as_str),
+                &args[1],
+                Some(port),
+                args[3] == "CONNECT",
+            )
+        };
+        println!(
+            "{}",
+            json!({"run_id": id, "basis": "recorded-policy", "scope": "authority-only", "decision": if reason.is_some() {"refused"} else {"passes-static"}, "reason": reason, "request_framing": "unevaluated", "dns": "unevaluated", "sni": "unevaluated", "delivery": "not-tested"})
+        );
+        return Ok(0);
+    }
+    if args.len() != 3 || args[1] != "--limit" {
+        return Err(io::Error::other("inspect-run RUN_ID --limit N"));
+    }
+    let limit: usize = args[2].parse().map_err(io::Error::other)?;
+    if !(1..=100).contains(&limit) {
+        return Err(io::Error::other("limit must be 1..100"));
+    }
+    let mut records = Vec::new();
+    let mut truncated = false;
+    let mut log_status = "not-applicable";
+    if !snapshot["egress"].is_null() {
+        match File::open(dirs::egress_dir()?.join(format!("{id}.jsonl"))) {
+            Ok(file) => {
+                log_status = "available";
+                let mut reader = BufReader::new(file.take(BYTES));
+                loop {
+                    let mut line = String::new();
+                    if reader.read_line(&mut line)? == 0 {
+                        break;
+                    }
+                    if records.len() == limit || !line.ends_with('\n') {
+                        truncated = true;
+                        break;
+                    }
+                    match serde_json::from_str::<Value>(&line) {
+                        Ok(value) => records.push(value),
+                        Err(_) => {
+                            log_status = "partial";
+                            break;
+                        }
+                    }
+                }
+                truncated |= reader.get_ref().limit() == 0;
+            }
+            Err(_) => log_status = "unavailable",
+        }
+    }
+    let terminal = read(id, "end.json").unwrap_or(json!({"availability": "not-observed"}));
+    println!(
+        "{}",
+        json!({"snapshot": snapshot, "terminal": terminal, "current_liveness": "not-probed", "egress": {"availability": log_status, "records": records, "truncated": truncated, "order": "oldest-first", "byte_limit": BYTES}})
+    );
+    Ok(0)
+}
