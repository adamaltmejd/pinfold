+/// Scratch for the #138 labvm boot check; never committed.
+pub fn scratch_disks(args: &[String]) -> io::Result<i32> {
+    let vmm = crate::core::artifacts::vmm(None)?;
+    let root = crate::core::image::root_disk(&args[0])?;
+    let init = std::path::PathBuf::from(&args[1]);
+    crate::core::artifacts::init_disk(&init)?;
+    println!(
+        "{} {} {} {}",
+        vmm.firecracker.display(),
+        vmm.kernel.display(),
+        root.display(),
+        init.display()
+    );
+    Ok(0)
+}
