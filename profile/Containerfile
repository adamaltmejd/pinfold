# The built-in default profile's image; scripts/bump-pins.py updates the
# ADD pins.
FROM debian:trixie-slim

# The tools Debian ships. fd-find is named fdfind there; pi looks for fd.
# unzip is a build-time tool for bun's release zip.
RUN set -eux; \
    export DEBIAN_FRONTEND=noninteractive; \
    apt-get update; \
    apt-get upgrade -y; \
    apt-get install -y --no-install-recommends \
        ca-certificates curl git ripgrep fd-find jq less poppler-utils unzip; \
    ln -s /usr/bin/fdfind /usr/local/bin/fd; \
    rm -rf /var/lib/apt/lists/*

# gh from GitHub's signed apt repository.
RUN set -eux; \
    export DEBIAN_FRONTEND=noninteractive; \
    mkdir -p /etc/apt/keyrings; \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends gh; \
    rm -rf /var/lib/apt/lists/*

ARG TARGETARCH

# The release downloads, one per architecture; the install step picks the
# pair matching TARGETARCH. Regenerated by bump-pins.py.
# >>> pins
ADD --checksum=sha256:54328bbc2d9c8e0c9f892c544d66c57a83b84139e34909e5ee81758f1ac8fda7 https://github.com/oven-sh/bun/releases/download/bun-v1.4.2/bun-linux-aarch64.zip /tmp/bun-aarch64.zip
ADD --checksum=sha256:36368faef7527875d5ffa52e53cd48021741f2a83eb6208a8dd64068d422a913 https://github.com/oven-sh/bun/releases/download/bun-v1.4.2/bun-linux-x64.zip /tmp/bun-x64.zip
ADD --checksum=sha256:8d6d1aad9e69b42481eda7039507d1f7ee93698f87713cecd873d287c1931632 https://github.com/rtk-ai/rtk/releases/download/v0.51.0/rtk-aarch64-unknown-linux-gnu.tar.gz /tmp/rtk-aarch64.tar.gz
ADD --checksum=sha256:5028d3b19a8f0990d30fec9fbb07e32782bc5698e618fb1861aad8a9ccba4eb5 https://github.com/rtk-ai/rtk/releases/download/v0.51.0/rtk-x86_64-unknown-linux-musl.tar.gz /tmp/rtk-x64.tar.gz
ADD --checksum=sha256:b5a24dcf8ec158326f3d3da92d7c0ea522dfbdf6c3de62a6a2ab98d5e683895f https://registry.npmjs.org/@dietrichgebert/ponytail/-/ponytail-4.12.0.tgz /tmp/ponytail.tgz
ADD --checksum=sha256:625bf6cdc24cc91eee8fbfe084c1fa56c71b17f034341d4a23bc8df0fdee31bd https://registry.npmjs.org/@firecrawl/anydoc/-/anydoc-0.2.4.tgz /tmp/anydoc.tgz
ADD --checksum=sha256:ed71661425a9959009d39ba495dbc565cc27a27f4eb0c93336b89f217e5c56b2 https://registry.npmjs.org/@firecrawl/anydoc-linux-arm64-gnu/-/anydoc-linux-arm64-gnu-0.2.4.tgz /tmp/anydoc-aarch64.tgz
ADD --checksum=sha256:ca822ea3ad29a9b9ca6b7f6d2a6b3d5311153af25a6c35a7f5bdf0791fe7f2c9 https://registry.npmjs.org/@firecrawl/anydoc-linux-x64-gnu/-/anydoc-linux-x64-gnu-0.2.4.tgz /tmp/anydoc-x64.tgz
# <<< pins

# Bun, rtk and AnyDoc on PATH; rtk's pi extension and the ponytail pi package
# outside $HOME, which is a mount at run time, for the profile's seed settings
# to name as packages. rtk init writes its extension 0600, so make the packages
# readable and traversable for the box user. AnyDoc's CLI runs on Bun beside
# its native package for this architecture, so the image needs no Node.
RUN set -eux; \
    case "${TARGETARCH}" in \
        arm64) arch=aarch64; native=anydoc-linux-arm64-gnu ;; \
        amd64) arch=x64; native=anydoc-linux-x64-gnu ;; \
        *) echo "unsupported architecture ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    anydoc=/opt/pinfold/anydoc/node_modules/@firecrawl; \
    mkdir -p /opt/pinfold/packages "${anydoc}/anydoc" "${anydoc}/${native}"; \
    unzip -q "/tmp/bun-${arch}.zip" -d /tmp/bun; \
    install -m 0755 /tmp/bun/bun-linux-*/bun /usr/local/bin/bun; \
    tar -xzf "/tmp/rtk-${arch}.tar.gz" -C /tmp; \
    install -m 0755 /tmp/rtk /usr/local/bin/rtk; \
    tar -xzf /tmp/ponytail.tgz -C /tmp; \
    mv /tmp/package /opt/pinfold/packages/ponytail; \
    tar -xzf /tmp/anydoc.tgz --strip-components=1 -C "${anydoc}/anydoc"; \
    tar -xzf "/tmp/anydoc-${arch}.tgz" --strip-components=1 -C "${anydoc}/${native}"; \
    printf '#!/bin/sh\nexec /usr/local/bin/bun %s/anydoc/cli.js "$@"\n' "${anydoc}" > /usr/local/bin/anydoc; \
    chmod 0755 /usr/local/bin/anydoc; \
    export HOME=/tmp/rtk-home; \
    mkdir -p "${HOME}"; \
    rtk init -g --agent pi; \
    mv "${HOME}/.pi/agent/extensions/rtk.ts" /opt/pinfold/packages/rtk.ts; \
    chmod -R a+rX /opt/pinfold; \
    rm -rf /tmp/bun /tmp/rtk /tmp/*.zip /tmp/*.tar.gz /tmp/*.tgz "${HOME}"

RUN find / -xdev -perm /6000 -type f -exec chmod a-s {} +
