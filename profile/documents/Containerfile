ARG TARGETARCH
FROM localhost/pinfold/profile-default:latest AS base

# Only the selected architecture's stage is built. Release archives stay
# in build stages; final images copy the installed files.
FROM base AS bun-arm64
ADD --checksum=sha256:18656a3bf0ea5641f5796ae4213b75255579a70a0fded2f337933785568cdf84 https://github.com/oven-sh/bun/releases/download/bun-v1.4.5/bun-linux-aarch64.zip /tmp/bun-aarch64.zip

FROM base AS bun-amd64
ADD --checksum=sha256:94559b3b528995a49452f9f2404cec74f2efd7d06e0a000a8cd214b02c3666eb https://github.com/oven-sh/bun/releases/download/bun-v1.4.5/bun-linux-x64.zip /tmp/bun-x64.zip

FROM bun-${TARGETARCH} AS bun-install
RUN set -eux; \
    export DEBIAN_FRONTEND=noninteractive; \
    apt-get update; \
    apt-get install -y --no-install-recommends unzip; \
    unzip -q /tmp/bun-*.zip -d /tmp/bun; \
    install -m 0755 /tmp/bun/bun-linux-*/bun /usr/local/bin/bun

FROM base AS anydoc-arm64
ADD --checksum=sha256:1158e39d22117743c8e127fcf3159322b850af9a4a7074a12934d77ef5aa23d7 https://registry.npmjs.org/@firecrawl/anydoc-linux-arm64-gnu/-/anydoc-linux-arm64-gnu-0.2.5.tgz /tmp/anydoc-aarch64.tgz

FROM base AS anydoc-amd64
ADD --checksum=sha256:f803e84667178cf6806de8e238364a34d3e00e3e85683496f1ff16a06fb26713 https://registry.npmjs.org/@firecrawl/anydoc-linux-x64-gnu/-/anydoc-linux-x64-gnu-0.2.5.tgz /tmp/anydoc-x64.tgz

FROM anydoc-${TARGETARCH} AS anydoc-install
ARG TARGETARCH
ADD --checksum=sha256:1071051300db213cdd6a6e94ead79079b7e992d7480a27002e25ed66808cff9d https://registry.npmjs.org/@firecrawl/anydoc/-/anydoc-0.2.5.tgz /tmp/anydoc.tgz
RUN set -eux; \
    case "${TARGETARCH}" in \
        arm64) native=anydoc-linux-arm64-gnu ;; \
        amd64) native=anydoc-linux-x64-gnu ;; \
    esac; \
    anydoc=/opt/pinfold/anydoc/node_modules/@firecrawl; \
    mkdir -p "${anydoc}/anydoc" "${anydoc}/${native}"; \
    tar -xzf /tmp/anydoc.tgz --strip-components=1 -C "${anydoc}/anydoc"; \
    tar -xzf /tmp/anydoc-*.tgz --strip-components=1 -C "${anydoc}/${native}"

FROM base AS documents
COPY --from=bun-install /usr/local/bin/bun /usr/local/bin/bun
COPY --from=anydoc-install /opt/pinfold/anydoc /opt/pinfold/anydoc
RUN set -eux; \
    export DEBIAN_FRONTEND=noninteractive; \
    apt-get update; \
    apt-get install -y --no-install-recommends poppler-utils; \
    rm -rf /var/lib/apt/lists/*; \
    printf '#!/bin/sh\nexec /usr/local/bin/bun /opt/pinfold/anydoc/node_modules/@firecrawl/anydoc/cli.js "$@"\n' > /usr/local/bin/anydoc; \
    chmod 0755 /usr/local/bin/anydoc; \
    chmod -R a+rX /opt/pinfold/anydoc

# Every built-in recipe ends here, so this link's own installs are stripped too.
RUN find / -xdev -perm /6000 -type f -exec chmod a-s {} +
