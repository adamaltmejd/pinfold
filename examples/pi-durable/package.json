{
  "name": "pinfold-pi-durable-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun --eval 'await import(process.argv[1]);' ./prototype.ts start",
    "resume": "bun --eval 'await import(process.argv[1]);' ./prototype.ts resume",
    "check": "bun --bun tsc --noEmit",
    "e2e": "bun durable_recovery_preserves_boxed_execution.ts"
  },
  "dependencies": {
    "@earendil-works/pi-durable": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/chord": "1.0.4"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "typescript": "6.0.2"
  },
  "overrides": {
    "@earendil-works/pi-telemetry": "1.0.4"
  }
}
